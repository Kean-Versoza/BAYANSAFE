{
  "name": "bayansafe",
  "version": "1.0.0",
  "private": true,
  "description": "BAYANSAFE - A Philippine Smart Community Disaster Intelligence and Preparedness Response Game (React + Node.js)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "db:setup": "node server/scripts/setupDb.js",
    "db:check": "node server/scripts/checkDb.js",
    "mail:check": "node server/scripts/checkMail.js",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}

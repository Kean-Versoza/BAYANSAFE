# Copy this file to ".env" and fill in your details.
# The .env file is in .gitignore, so your passwords stay on your computer.
#
#   copy .env.example .env      (Windows: copy .env.example .env)

# ============================================================
# The database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://bayansafe:bayansafe@localhost:5432/bayansafe

# If you use a hosted database (Neon, Supabase, Railway), turn SSL on:
# DATABASE_SSL=true

# Or fill in the parts one by one instead of DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=bayansafe
# PGUSER=bayansafe
# PGPASSWORD=bayansafe

# How many connections the server keeps open. A deployed site (Vercel) starts
# a new pool in every function instance, and a small hosted database only
# allows a handful of connections in total, so keep this low there.
# PGPOOL_MAX=5

# ============================================================
# The admin dashboard
# ============================================================
# The email the admin signs in with, and the password for /admin.
# Change the password to something only you know.
ADMIN_EMAIL=bayansafe.admin@gmail.com
ADMIN_PASSWORD=bayansafe-admin

# A long random text that signs the admin cookie.
# Leave it empty and the admin password is used instead.
SESSION_SECRET=

# ============================================================
# Sending email
# ============================================================
# Which provider to use: gmail, brevo, resend or custom.
MAIL_PROVIDER=gmail

# ---- Gmail ----------------------------------------------------
# Needs an app password: turn on 2-Step Verification, then open
# https://myaccount.google.com/apppasswords
# If that page says app passwords are not available for your account,
# your account is managed by a school or organisation, or you are
# signed in with a non-Google account. Use MAIL_PROVIDER=brevo below.
GMAIL_USER=yourteam@gmail.com
GMAIL_APP_PASSWORD=

# ---- Brevo (no app password needed) --------------------------
# Free account: https://www.brevo.com
# Copy the login and the SMTP key from Settings > SMTP & API.
# BREVO_USER=yourteam@yourteam.com
# BREVO_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxx

# ---- Resend (no app password needed) -------------------------
# Free account: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_USER=yourteam@gmail.com

# ---- Any other SMTP server -----------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourteam@example.com
# SMTP_PASSWORD=your-password

# ---- Shared settings -----------------------------------------
# Optional: the address the messages are sent from.
# Leave it empty to use the provider's own address.
MAIL_FROM=

# Optional: where the messages from the contact form should arrive.
# Leave it empty to send them to your own address.
MAIL_TO=

# ============================================================
# On a deployed site (Vercel)
# ============================================================
# There is no .env file on Vercel. The same variables are filled in under
# Project > Settings > Environment Variables, and they have to be added for
# Production, Preview and Development:
#
#   DATABASE_URL     the database, hosted or otherwise
#   ADMIN_EMAIL      the email the admin signs in with
#   ADMIN_PASSWORD   the password for /admin
#   SESSION_SECRET   a long random text (openssl rand -hex 32)
#   DATABASE_SSL     "true" for most hosted databases
#   PGPOOL_MAX       1 or 2, so the function does not open too many connections
#   MAIL_*           the email settings, if the site should send mail
#
# Nothing here is secret to the outside world once it is filled in, so use
# passwords that are only used for this site.

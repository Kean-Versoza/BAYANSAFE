# Copy this file to ".env" and fill in your details.
# The .env file is in .gitignore, so your passwords stay on your computer.
#
#   copy .env.example .env      (Windows: copy .env.example .env)

# ============================================================
# The database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://bayansafe:bayansafe@localhost:5432/bayansafe

# If you use a hosted database (Neon, Supabase, Railway), turn SSL on:
# DATABASE_SSL=true

# Or fill in the parts one by one instead of DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=bayansafe
# PGUSER=bayansafe
# PGPASSWORD=bayansafe

# ============================================================
# The admin dashboard
# ============================================================
# The password for /admin. Change this to something only you know.
ADMIN_PASSWORD=bayansafe-admin

# A long random text that signs the admin cookie.
# Leave it empty and the admin password is used instead.
SESSION_SECRET=

# ============================================================
# Sending email
# ============================================================
# Which provider to use: gmail, brevo, resend or custom.
MAIL_PROVIDER=gmail

# ---- Gmail ----------------------------------------------------
# Needs an app password: turn on 2-Step Verification, then open
# https://myaccount.google.com/apppasswords
# If that page says app passwords are not available for your account,
# your account is managed by a school or organisation, or you are
# signed in with a non-Google account. Use MAIL_PROVIDER=brevo below.
GMAIL_USER=yourteam@gmail.com
GMAIL_APP_PASSWORD=

# ---- Brevo (no app password needed) --------------------------
# Free account: https://www.brevo.com
# Copy the login and the SMTP key from Settings > SMTP & API.
# BREVO_USER=yourteam@yourteam.com
# BREVO_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxx

# ---- Resend (no app password needed) -------------------------
# Free account: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_USER=yourteam@gmail.com

# ---- Any other SMTP server -----------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourteam@example.com
# SMTP_PASSWORD=your-password

# ---- Shared settings -----------------------------------------
# Optional: the address the messages are sent from.
# Leave it empty to use the provider's own address.
MAIL_FROM=

# Optional: where the messages from the contact form should arrive.
# Leave it empty to send them to your own address.
MAIL_TO=
